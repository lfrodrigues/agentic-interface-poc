# RUN BACKEND


$ python3 -m venv venv 

$ source venv/bin/activate

$ pip install uv

$ uv pip install -r agent/pyproject.toml

$ cd agent

$ cp agno2/.env_template  agno2/.env

Fill in the .env file with the correct credentials

$ ./manage.py migrate

$ ./manage.py runserver 0.0.0.0:8000

# RUN AGENT INTERACTIVE 

$ ./manage.py interactive_agent

# INSTALL FRONTEND EXPO

cd mobile-app/

npm install

npm run android


# CREATE USERS 

python3 scripts/test_create_user.py

# DELETE USER

python3 scripts/test_delete_user.py